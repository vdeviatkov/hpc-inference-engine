---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
IndentWidth: 2
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IncludeBlocks: Regroup
IncludeCategories:
  # Project headers last, after the standard library and third-party headers.
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  - Regex: '^<.*>$'
    Priority: 2
  - Regex: '^"hie/.*"'
    Priority: 3
  - Regex: '.*'
    Priority: 4
...
